# NAVTools Environment Variables
# Copy this file to .env and fill in the values

NAVTOOLS_API_BASE_URL=https://workspace.navtools.vn
NAVTOOLS_CLIENT_API_KEY=your-api-key-here
NAVTOOLS_GSHEET_SHEET_ID=your-gsheet-id-here

# Optional: Headless mode for browser automation (True/False)
NAVTOOLS_HEADLESS=False
